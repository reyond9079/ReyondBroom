# Unified diff context intentionally preserves upstream tabs and blank lines.
*.patch -whitespace
runtime/*.fgd -whitespace

*.sh text eol=lf
assets/reyond-shader-pack/** text eol=lf
assets/reyond-shader-pack/**/*.tga binary
assets/reyond-shader-pack/**/*.ktx binary
runtime/download-shader-pack.* text eol=lf
runtime/reyond-shader-pack.json text eol=lf
runtime/characters/LICENSE-CC0.md text eol=lf
runtime/characters/examples/*.rbchar text eol=lf

# These files are included byte-for-byte in the Texture Studio dependency inventory.
native/third_party/json.hpp text eol=lf
native/third_party/stb_image.h text eol=lf
native/third_party/stb_image_write.h text eol=lf
