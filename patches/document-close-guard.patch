diff --git a/engine/client/cl_main.c b/engine/client/cl_main.c
index 162c446..87e4e8a 100644
--- a/engine/client/cl_main.c
+++ b/engine/client/cl_main.c
@@ -475,6 +475,13 @@ void CL_Quit_f (void)
 	if (!host_initialized)
 		return;
 
+	// Let the editor protect unsaved MAP edits before shutting down.
+	if (strcmp(Cmd_Argv(1), "force") && Cvar_VariableValue("ftebroom_dirty") && Cmd_Exists("ftebroom_ui"))
+	{
+		Cmd_ExecuteString("ftebroom_ui exit", RESTRICT_LOCAL);
+		return;
+	}
+
 	if (forcesaveprompt && strcmp(Cmd_Argv(1), "force"))
 	{
 		forcesaveprompt = false;
diff --git a/engine/client/menu.c b/engine/client/menu.c
