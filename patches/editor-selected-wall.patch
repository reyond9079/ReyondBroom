+// Editor wall overrides belong to editable materials. Compiled BSP models
+// have their own shader registrations and must keep the game's lighting.
+static program_t *Shader_FindMaterialProgram(const shader_t *shader, char *name, int qrtype)
+{
+	char editorname[1024];
+	if ((!shader->model || shader->model->type != mod_brush) &&
+	    !strncmp(name, "defaultwall", 11) && (!name[11] || name[11]=='#'))
+	{
+		cvar_t *editorwall = Cvar_Get("ftebroom_wall_override", "0", CVAR_NOTFROMSERVER|CVAR_NOSAVE, "FTEBroom");
+		if (editorwall->ival)
+		{
+			Q_snprintfz(editorname, sizeof(editorname), "ftebroom_selected_wall%s", name+11);
+			name = editorname;
+		}
+	}
+	return Shader_FindGeneric(name, qrtype);
+}
