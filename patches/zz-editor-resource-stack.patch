+// The editor owns writable files/configs. Map resources only supply assets;
+// they are added before manifest paths so editor overlays retain priority.
+static void FS_AddEditorResourceDirectories(searchpath_t **oldpaths, unsigned int reloadflags)
+{
+	const char *entry = ftebroom_mapassetpaths.string;
+	unsigned int index = 0;
+	if (*entry)
+	{
+		while (*entry)
+		{
+			const char *end = strchr(entry, ';');
+			size_t length = end ? (size_t)(end-entry) : strlen(entry);
+			char directory[MAX_OSPATH], puredir[64];
+			if (length && length < sizeof(directory))
+			{
+				memcpy(directory, entry, length);
+				directory[length] = 0;
+				// Do not reinterpret a malformed relative path against the editor cwd.
+				if (directory[0] == '/' || directory[0] == '\\' ||
+					(length >= 3 && directory[1] == ':' && (directory[2] == '/' || directory[2] == '\\')))
+				{
+					Q_snprintfz(puredir, sizeof(puredir), "ftebroom-map-%u", index++);
+					FS_AddSingleGameDirectory(oldpaths, puredir, directory,
+						reloadflags, SPF_PRIVATE|SPF_COPYPROTECTED);
+				}
+				else
+					Con_Printf("Ignoring relative editor resource directory: %s\n", directory);
+			}
+			else if (length)
+				Con_Printf("Ignoring an editor resource directory longer than MAX_OSPATH\n");
+			if (!end)break;
+			entry = end+1;
+		}
+	}
+	else
+	{
+		if (*ftebroom_assetpath.string)
+			FS_AddSingleGameDirectory(oldpaths, "baseq3", ftebroom_assetpath.string,
+				reloadflags, SPF_PRIVATE|SPF_COPYPROTECTED);
+		if (*ftebroom_modassetpath.string)
+			FS_AddSingleGameDirectory(oldpaths, "ftebroom-mod", ftebroom_modassetpath.string,
+				reloadflags, SPF_PRIVATE|SPF_COPYPROTECTED);
+	}
 }
