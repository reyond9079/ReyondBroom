+/* ReyondBroom dynamic authoring mesh, ABI v1. Main-thread upload and scene draw. */
+static unsigned char *rb_dynmesh;
+static size_t rb_dynsize;
+static double rb_dynstats[4];
+static unsigned rb_read32(const unsigned char *p){unsigned v;memcpy(&v,p,4);return v;}
+static int rb_dyn_upload(const void *bytes,size_t size)
+{
+ const unsigned char *p=bytes,*end=p+size;unsigned surfaces,i,j;double start=Sys_DoubleTime();
+ if(!bytes||size<8||size>32*1024*1024||memcmp(p,"RBB1",4))return 0;
+ surfaces=rb_read32(p+4);p+=8;if(surfaces>256)return 0;
+ for(i=0;i<surfaces;i++){
+  unsigned nv,ni;if(end-p<136)return 0;nv=rb_read32(p);ni=rb_read32(p+4);
+  if(nv>65536||ni>393216||ni%3||!memchr(p+8,0,128))return 0;p+=136;
+  if((size_t)(end-p)<(size_t)nv*36+(size_t)ni*4)return 0;
+  for(j=0;j<nv*9;j++){float v;memcpy(&v,p+j*4,4);if(!isfinite(v)||fabs(v)>1e8)return 0;}
+  p+=nv*36;for(j=0;j<ni;j++)if(rb_read32(p+j*4)>=nv)return 0;p+=ni*4;
+ }
+ if(p!=end)return 0;
+ rb_dynmesh=BZ_Realloc(rb_dynmesh,size);memcpy(rb_dynmesh,bytes,size);rb_dynsize=size;
+ rb_dynstats[0]=(Sys_DoubleTime()-start)*1000;return 1;
+}
+static void rb_dyn_clear(void){if(rb_dynmesh)BZ_Free(rb_dynmesh);rb_dynmesh=NULL;rb_dynsize=0;}
+static void rb_dyn_stats(double *out){memcpy(out,rb_dynstats,sizeof(rb_dynstats));}
+void *RB_DynamicMeshInterface(size_t size)
+{
+ static struct {int(*upload)(const void*,size_t);void(*clear)(void);void(*stats)(double*);} api={rb_dyn_upload,rb_dyn_clear,rb_dyn_stats};
+ return size==sizeof(api)?&api:NULL;
+}
