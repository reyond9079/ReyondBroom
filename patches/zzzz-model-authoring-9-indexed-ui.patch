+/* ReyondBroom indexed UI ABI: packed x/y/u/v floats + RGBA bytes, with
+ * 16/32-bit local indices. No ImGui or graphics API dependency in the ABI. */
+static int rb_ui_draw(const void *vertices, unsigned nv, const void *indices,
+ unsigned ni, unsigned indexbytes, int image, const float *clip)
+{
+ static vecV_t *xyz;static vec2_t *st;static avec4_t *colors;static index_t *ix;
+ static unsigned vertexcap,indexcap;
+ mesh_t mesh;srect_t rect;unsigned i,j,maxvertex=0;const unsigned char *v=vertices;
+ shader_t *shader;
+ if(qrenderer==QR_NONE||!vertices||!indices||!clip||!nv||nv>65536||!ni||ni>3000000||ni%3||
+   (indexbytes!=2&&indexbytes!=4)||image<=0||image>r_numshaders)return 0;
+ for(i=0;i<4;i++)if(!isfinite(clip[i]))return 0;
+ if(clip[2]<=clip[0]||clip[3]<=clip[1])return 1;
+ for(i=0;i<ni;i++){unsigned index=indexbytes==2?((const unsigned short*)indices)[i]:((const unsigned*)indices)[i];if(index>=nv)return 0;maxvertex=max(maxvertex,index);}
+ nv=maxvertex+1;
+ if(nv>vertexcap){vertexcap=nv;xyz=BZ_Realloc(xyz,sizeof(*xyz)*nv);st=BZ_Realloc(st,sizeof(*st)*nv);colors=BZ_Realloc(colors,sizeof(*colors)*nv);}
+ if(ni>indexcap){indexcap=ni;ix=BZ_Realloc(ix,sizeof(*ix)*ni);}
+ for(i=0;i<nv;i++){
+  const float *p=(const float*)(v+i*20);
+  for(j=0;j<4;j++)if(!isfinite(p[j]))return 0;
+  xyz[i][0]=p[0];xyz[i][1]=p[1];xyz[i][2]=0;st[i][0]=p[2];st[i][1]=p[3];
+  for(j=0;j<4;j++)colors[i][j]=v[i*20+16+j]*(1.0f/255);
+ }
+ for(i=0;i<ni;i++)ix[i]=indexbytes==2?((const unsigned short*)indices)[i]:((const unsigned*)indices)[i];
+ for(i=0;i<ni;i+=3){unsigned a=ix[i],b=ix[i+1],c=ix[i+2];if((xyz[b][0]-xyz[a][0])*(xyz[c][1]-xyz[a][1])-(xyz[b][1]-xyz[a][1])*(xyz[c][0]-xyz[a][0])<0){ix[i+1]=c;ix[i+2]=b;}}
+ shader=r_shaders[image-1];if(!shader)return 0;
+ if(R2D_Flush)R2D_Flush();
+ memset(&mesh,0,sizeof(mesh));mesh.numvertexes=nv;mesh.numindexes=ni;
+ mesh.xyz_array=xyz;mesh.st_array=st;mesh.colors4f_array[0]=colors;mesh.indexes=ix;
+ rect.x=clip[0]/vid.fbvwidth;rect.width=(clip[2]-clip[0])/vid.fbvwidth;
+ rect.height=(clip[3]-clip[1])/vid.fbvheight;rect.y=1-clip[1]/vid.fbvheight-rect.height;
+ rect.dmin=-99999;rect.dmax=99999;
+ BE_Scissor(&rect);BE_DrawMesh_Single(shader,&mesh,NULL,r2d_be_flags);BE_Scissor(NULL);
+ return 1;
+}
+void *RB_IndexedUIInterface(size_t size){
+ static struct{int(*draw)(const void*,unsigned,const void*,unsigned,unsigned,int,const float*);}api={rb_ui_draw};
+ return size==sizeof(api)?&api:NULL;
+}
