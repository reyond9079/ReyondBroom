"height" default to 200, the speed thrown upwards<string key="target" name="target"/><string key="targetname" name="targetname"/><string key="angle" name="angle"/><string key="speed" name="speed"/><flag bit="8" name="Not on easy"/><flag bit="9" name="Not on normal"/><flag bit="10" name="Not on hard"/><flag bit="11" name="Not in deathmatch"/></group>
